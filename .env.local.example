# Firebase Console > Project settings > General > Your apps > SDK setup and configuration
# dan olinadigan qiymatlarni shu yerga qo'ying, so'ng faylni .env.local deb saqlang.
# .env.local hech qachon Git'ga yuklanmasligi kerak (.gitignore'da bor).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-side, faqat app/api/teacher/** route'lari uchun) ---
# Firebase Console > Project settings > Service accounts > "Generate new private key"
# orqali yuklab olingan JSON fayldan: project_id, client_email, private_key.
# Ustoz o'quvchi qo'shganda/parolini yangilaganda ishlatiladi (lib/firebaseAdmin.js).
# DIQQAT: bu qiymatlar maxfiy — hech qachon NEXT_PUBLIC_ prefiksi bilan yozilmasin
# va Git'ga yuklanmasin.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# private_key qiymatini qo'shtirnoq ichida, qatorlarni \n bilan almashtirib qo'ying:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Admin sahifasi (app/admin, faqat app/api/admin/** route'lari uchun) ---
# 0-QISM 6-PROMPT: admin sahifasi oddiy umumiy parol bilan himoyalangan
# (Firebase Auth emas). O'zingiz xohlagan, taxmin qilish qiyin bo'lgan
# qiymat qo'ying. Bu qiymat MAXFIY, lekin build vaqtida emas, faqat
# so'rov kelganda o'qiladi — shuning uchun Netlify'da "secret" belgisisiz
# ham qo'yish mumkin.
ADMIN_SECRET_PASSWORD=
