rules_version = '2';

// MVP xavfsizlik qoidalari — 2-PROMPT (autentifikatsiya) uchun yetarli.
// Firebase konsolida: Firestore Database > Rules bo'limiga joylashtiring
// (yoki Firebase CLI: `firebase deploy --only firestore:rules`).
//
// Eslatma: registratsiya oqimi login bandligini Firestore so'rovi bilan emas,
// Firebase Auth'ning "auth/email-already-in-use" xatosi orqali tekshiradi
// (lib/accountHelpers.js), shuning uchun ro'yxatdan o'tishda anonim foydalanuvchi
// uchun `users` kolleksiyasini o'qishga ruxsat berish shart emas.
service cloud.firestore {
  match /databases/{database}/documents {

    // Ustoz shu foydalanuvchining (agar student bo'lsa) sinfini boshqarayotgan
    // ustoz ekanini tekshiradi — users va classes qoidalarida qayta ishlatiladi.
    function isOwningTeacher(studentData) {
      return studentData.classId != null &&
        exists(/databases/$(database)/documents/classes/$(studentData.classId)) &&
        get(/databases/$(database)/documents/classes/$(studentData.classId)).data.teacherId == request.auth.uid;
    }

    // Har bir foydalanuvchi faqat o'z profilini o'qiy/yoza oladi.
    // create/update: Firebase Auth akkount yaratilgach (yoki kirgach) darhol
    // shu foydalanuvchi nomidan bajariladi, shuning uchun request.auth.uid
    // yangi hujjat ID'siga (== UID) teng bo'lishi kerak.
    //
    // Bundan tashqari, ustoz o'ziga tegishli sinfdagi o'quvchilarning
    // profilini o'qiy oladi (sinf ichidagi ro'yxat uchun) va faqat o'quvchini
    // sinfdan chiqarish uchun (classId -> null) yangilay oladi. O'quvchi
    // akkountini yaratish va parolini yangilash esa Admin SDK orqali
    // (app/api/teacher/**) bajariladi, bu qoidalardan chetlab o'tadi.
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isOwningTeacher(resource.data));
      // create: yangi foydalanuvchi o'zini sinfga biriktirib yoki hashteg/parol
      // maydonlarini oldindan yozib ro'yxatdan o'ta olmasin — classId,
      // qoshilishUsuli va currentPassword faqat serverda (Admin SDK) beriladi.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get("classId", null) == null &&
        !("qoshilishUsuli" in request.resource.data) &&
        !("currentPassword" in request.resource.data);
      // update: o'zi faqat akkount ma'lumotlarini (ism, familiya, viloyat, tuman)
      // o'zgartira oladi — classId, qoshilishUsuli, currentPassword, umumiyBali va
      // h.k. ni emas (aks holda o'quvchi hashtegsiz istalgan sinfga "kirib" olardi).
      allow update: if request.auth != null &&
        ((request.auth.uid == userId &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["ism", "familiya", "viloyat", "tuman"])) ||
          (isOwningTeacher(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["classId"]) &&
            request.resource.data.classId == null));
      allow delete: if false;
    }

    // Sinflar — faqat egasi bo'lgan ustoz yarata/ko'ra/o'zgartira/o'chira oladi.
    // Sinf yaratish endi serverda (app/api/teacher/classes — noyob hashteg
    // beriladi), shuning uchun client'dan create yopiq; hashtegni ustoz ham
    // o'zgartira olmaydi.
    match /classes/{classId} {
      allow create: if false;
      allow read, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
      allow update: if request.auth != null && resource.data.teacherId == request.auth.uid &&
        request.resource.data.get("hashteg", null) == resource.data.get("hashteg", null);
    }

    // Xabarlar (ustoz inbox) va sinfga qo'shilish so'rovlari faqat serverda
    // (app/api/teacher/messages, app/api/student/join) o'qiladi/yoziladi.
    match /messages/{messageId} {
      allow read, write: if false;
    }
    match /joinRequests/{studentId} {
      allow read, write: if false;
    }

    // Mavzular — har qanday kirgan foydalanuvchi o'qiy oladi (nomi/tartibi
    // sezgir emas). Savollar, urinishlar va jonlar endi CLIENT'DAN UMUMAN
    // O'QILMAYDI/YOZILMAYDI — barchasi faqat serverda (app/api/student/**,
    // Admin SDK orqali, bu qoidalardan chetlab o'tadi) ishlaydi. Bu orqali
    // to'g'ri javob (togriJavobIndex) hech qachon brauzerga tushmaydi —
    // faqat javob berilgandan KEYIN, o'sha savol uchun serverdan qaytariladi.
    match /mavzular/{mavzuId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /savollar/{savolId} {
      allow read, write: if false;
    }
    match /urinishlar/{urinishId} {
      allow read, write: if false;
    }
    match /jonlar/{jonId} {
      allow read, write: if false;
    }

    // Boshqa har qanday hujjat — standart holatda rad etiladi.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
